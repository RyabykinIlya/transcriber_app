APP_PORT=8565
APP_DEBUG=False
HF_TOKEN=<YOUR HF KEY IF YOU WANT SPEAKER DIARIZATION>

# --- Adaptive chunking ---
# Target chunk size; actual cuts snap to the nearest silence inside
# CHUNK_SILENCE_SEARCH_MS around the target point.
CHUNK_TARGET_MS=900000
# Hard bounds: never cut more often than MIN, never longer than MAX.
# Recording shorter than MAX is processed as a single chunk.
CHUNK_MIN_MS=120000
CHUNK_MAX_MS=1800000
CHUNK_SILENCE_SEARCH_MS=30000
# Safety margin around each chunk slice (only needed when a cut lands
# in the middle of speech because no silence was found nearby).
CHUNK_OVERLAP_MS=3000
# What counts as a silence for cut snapping.
CHUNK_MIN_SILENCE_MS=500
# If a chunk fails (CUDA error etc.) it is retried and then bisected
# down to this size before giving up on that range.
CHUNK_BISECT_MIN_MS=30000

# --- Decoding quality ---
# Corporate glossary biasing (initial_prompt): ~2x correctly spelled
# domain terms, no speed cost. Built-in default covers internal meetings;
# override here or per request (initial_prompt / hotwords params).
# WHISPER_INITIAL_PROMPT=ЗНИ, ФТТ, ...
# WHISPER_HOTWORDS=
ASR_BEAM_SIZE=5

# Diarization: needs one-time license acceptance, see README "Качество".
# DIARIZE_MODEL=pyannote/speaker-diarization-community-1
# DIARIZE_DEVICE=cuda
# How many voices to look for when diarization runs without an explicit
# `speakers_count` (a non-empty voice gallery also turns it on).
DIARIZE_MAX_SPEAKERS=8

# Voice gallery: colleagues are enrolled into MEDIA_FOLDER/voiceprints.json
# (POST /enroll_voice with `audio_name` + `windows`, see README). Every
# enrolled voice is labelled by name on every file; the rest stay SPEAKER_XX.
# The legacy single-print MEDIA_FOLDER/voiceprint.json is still read as a
# one-entry gallery.
SPEAKER_NAME=Илья Рябыкин
# Cosine threshold; calibration: own voice ~1.0 (studio) / ~0.71 (meeting
# mic), other people 0.13-0.37. 0.60 sits in the middle of the gap. When the
# gallery grows, watch the logged "Voice match ..." scores and retune.
VOICE_MATCH_THRESHOLD=0.60

# --- Model ---
# NOTE: on an 8GB GPU (RTX 3070 Ti) batch_size=8 with long chunks makes
# faster-whisper ~20x slower (measured); 4 is optimal there.
BATCH_SIZE=4
COMPUTE_TYPE=float16
DEVICE=cuda
MEDIA_FOLDER=<PATH TO MEDIA>

# Preload whisper+align at container start
PRELOAD=1
# Do NOT set PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True — measured to
# break pyannote embedding inference ("CUDA driver error: device not ready").
LOGGING_LEVEL=INFO
